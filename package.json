{
  "name": "huette-kalender",
  "version": "1.0.0",
  "private": true,
  "description": "Gruppen-Website mit Kalender, Admin-Login, Passwortsperre und Mitgliederverwaltung",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch server.js",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "passwort": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/set-password.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^5.3.0"
  }
}
