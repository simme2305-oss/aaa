# Kopiere diese Datei nach .env und passe die Werte an.

# Name der Gruppe (oben links auf der Seite)
APP_NAME=Hütte Ebenweiler

# Admin-Zugang – wird nur beim allerersten Start angelegt
ADMIN_USERNAME=admin
ADMIN_PASSWORD=bitte-aendern

# Port des Servers
PORT=3000

# Ordner für die Datenbank (muss bei Hostern dauerhaft gespeichert werden)
# DATA_DIR=./data
